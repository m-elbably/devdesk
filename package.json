{
  "name": "devdesk",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp",
      "vue-demi"
    ]
  },
  "scripts": {
    "dev": "pnpm dev:api & pnpm dev:desktop; kill %1",
    "dev:desktop": "pnpm --filter @devdesk/desktop dev",
    "dev:api": "pnpm --filter @devdesk/sync-api dev",
    "dev:api:migrate": "pnpm --filter @devdesk/sync-api db:migrate",
    "desktop": "pnpm --filter @devdesk/desktop dev & pnpm --filter @devdesk/desktop neu:run; kill %1",
    "build:desktop": "pnpm --filter @devdesk/desktop build && pnpm --filter @devdesk/desktop neu:build",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "release": "git diff --quiet && git diff --quiet --cached || (echo 'commit or stash changes first' >&2 && exit 1) && pnpm version ${1:-patch} -m \"chore: release v%s\" && git push --follow-tags"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@neutralinojs/neu": "^11.7.2",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.5",
    "vue-eslint-parser": "^9.4.3"
  }
}
